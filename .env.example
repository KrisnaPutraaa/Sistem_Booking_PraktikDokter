# Salin ke .env.local lalu isi nilainya. Jangan commit .env.local.
# Nilai kunci disimpan di pengelola kata sandi, bukan di chat atau repo.

# Publik (boleh terlihat di browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Kunci "publishable" (sb_publishable_...) dari Supabase, Project Settings, API Keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Turnstile: bila site key DAN secret sama-sama kosong, development lokal dan Preview Vercel
# memakai kunci uji Cloudflare (selalu lolos). Produksi wajib kunci asli; kunci uji ditolak.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Rahasia: server saja, JANGAN diberi awalan NEXT_PUBLIC
# Kunci "secret" (sb_secret_...) dari Supabase, Project Settings, API Keys.
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=

# Uji database (npm run test:db). Ref project DEV saja (20 karakter, bagian depan
# URL https://<ref>.supabase.co). Jangan pernah isi dengan project produksi.
# test:db hanya jalan bila SUPABASE_ALLOW_TEST_DB=1 diberikan di perintah, bukan di file ini:
#   PowerShell: $env:SUPABASE_ALLOW_TEST_DB=1; npm run test:db
SUPABASE_DEV_PROJECT_REF=

# Zona waktu tidak diatur lewat env: konstanta APP_TIMEZONE di src/lib/time.ts (Asia/Makassar).
